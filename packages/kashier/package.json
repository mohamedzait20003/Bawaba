{
  "name": "@bawaba/kashier",
  "version": "0.0.0",
  "description": "Kashier client for Bawaba. Unofficial. Not affiliated with Paymob, Kashier, Fawry, Geidea, PayTabs, Amazon Payment Services or Tap Payments.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "@bawaba/source": "./src/index.ts",
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./webhooks": {
      "@bawaba/source": "./src/webhooks.ts",
      "import": {
        "types": "./dist/webhooks.d.ts",
        "default": "./dist/webhooks.js"
      },
      "require": {
        "types": "./dist/webhooks.d.cts",
        "default": "./dist/webhooks.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsdown",
    "check": "publint && attw --pack . --profile node16"
  },
  "dependencies": {
    "@bawaba/core": "workspace:^"
  },
  "devDependencies": {
    "@bawaba/testing": "workspace:^"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bawaba/bawaba.git",
    "directory": "packages/kashier"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
