{
  "name": "bawaba-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/*\" build",
    "typecheck": "tsc -p tsconfig.json && tsc -p scripts/tsconfig.json && tsc -p tools/tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "lint": "biome check .",
    "format": "biome format --write .",
    "check:packages": "pnpm -r --filter \"./packages/*\" check",
    "check:deps": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/check-deps.ts",
    "check:secrets": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/check-no-secrets.ts",
    "smoke": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/smoke/run.ts",
    "smoke:runtime": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/smoke/runtimes.ts",
    "ci": "pnpm lint && pnpm typecheck && pnpm check:deps && pnpm check:secrets && pnpm test:coverage && pnpm build && pnpm check:packages && pnpm smoke",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build && changeset publish"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "catalog:",
    "@biomejs/biome": "catalog:",
    "@changesets/cli": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "msw": "catalog:",
    "publint": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
