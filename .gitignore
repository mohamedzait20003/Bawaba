# Dependencies
node_modules/

# Build output
dist/
coverage/
*.tsbuildinfo

# Packed tarballs and smoke-test consumers
*.tgz
scripts/smoke/.tmp/

# Raw captures and unsigned drafts from the validation tools: may hold sandbox personal data, never committed
tools/.captures/

# Wrangler state for the webhook receiver
tools/webhook-receiver/.wrangler/

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Environment and secrets: never commit gateway credentials
.env
.env.*
!.env.example

# Local Claude Code settings
.claude/settings.local.json

# Editors and OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
